# Plantilla. Copia este archivo como .env.local y rellena los dos valores:
#
#   cp .env.example .env.local
#
# .env.local esta en .gitignore, asi que no se sube al repo. Este archivo NO
# debe contener valores reales: solo documenta que variables hacen falta.
#
# Los encuentras en Supabase > Project Settings > API:
#   EXPO_PUBLIC_SUPABASE_URL      -> "Project URL"
#   EXPO_PUBLIC_SUPABASE_ANON_KEY -> clave "anon" / "publishable"
#
# El prefijo EXPO_PUBLIC_ hace que Expo incruste el valor en el bundle, asi
# que la clave anon acaba siendo visible para cualquiera que abra la app. Eso
# es correcto y esta pensado asi: lo que protege los datos es el RLS del
# esquema (ver Migration/007_rls.sql), no ocultar la clave.
#
# NUNCA pongas aqui ni en .env.local la clave service_role: esa SI salta el
# RLS por completo.

EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=TU_CLAVE_ANON
