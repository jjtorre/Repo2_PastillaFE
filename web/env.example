# Plantilla. Copia este archivo como .env.local y rellena los dos valores:
#
#   cp .env.example .env.local
#
# .env.local esta cubierto por la regla *.local del .gitignore. Este archivo
# NO debe contener valores reales: solo documenta que variables hacen falta.
#
# Son LOS MISMOS valores que usa la app movil (myApp/.env.local), solo que
# Vite exige el prefijo VITE_ en vez de EXPO_PUBLIC_. Los encuentras en
# Supabase > Project Settings > API.
#
# La clave anon acaba incrustada en el bundle y es visible para cualquiera:
# es correcto y esta pensado asi. Lo que protege los datos es el RLS del
# esquema (Migration/007_rls.sql).
#
# NUNCA pongas aqui la clave service_role: esa SI salta el RLS por completo.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_CLAVE_ANON
